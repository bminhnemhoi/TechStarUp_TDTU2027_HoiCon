# Mẫu biến môi trường backend — KHÔNG commit backend/.env (đã gitignore).
# Tạo nhanh: uv run --directory backend python -m hoicon.ops.init_env   (Minh tự chạy; tự sinh pepper + webhook secret)
# Kiểm tra: uv run --directory backend python -m hoicon.ops.check_keys  (chỉ in Đạt/Thiếu/Lỗi)
# Claude Code không được đọc/ghi .env (quy tắc deny + hook guard-shell); chỉ đọc file mẫu này.

HOICON_ENV=dev
# Mặc định đã trỏ Postgres dev 127.0.0.1:15432 (infra/compose.dev.yml); chỉ đặt khi khác.
# HOICON_DATABASE_URL=postgresql+psycopg://hoicon:hoicon_dev@127.0.0.1:15432/hoicon

# --- Khóa dịch vụ: Minh dán tay (docs/setup/ACCOUNTS.md) ---
# HOICON_ANTHROPIC_API_KEY=
# HOICON_GEMINI_API_KEY=
# HOICON_ZALO_BOT_TOKEN=

# --- Sinh tự động bởi init_env ---
# HOICON_ZALO_WEBHOOK_SECRET=     # 8–256 ký tự; Zalo gửi lại trong header X-Bot-Api-Secret-Token
# HOICON_PHONE_PEPPER_KID=1
# HOICON_PHONE_PEPPER_1=          # HMAC pepper (ADR-006), hex 64 ký tự — mất là không so khớp lại được số đã băm
