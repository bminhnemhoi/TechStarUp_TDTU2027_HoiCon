{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoicon.vn/schemas/consent_record.v1.json",
  "title": "ConsentRecord v1",
  "description": "Lô bản ghi đồng ý từ thiết bị gửi lên qua `POST /v1/consents` (spec 020, P2-01). Bảng consents là append-only, chống sửa/xóa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "granted", "consent_version", "text_sha256", "channel"],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "core_protection",
              "call_screening",
              "usage_monitoring",
              "overlay_pause",
              "guardian_alerts",
              "llm_processing",
              "voice_input",
              "drills",
              "pilot_research"
            ]
          },
          "granted": { "type": "boolean" },
          "consent_version": { "type": "string", "minLength": 1, "maxLength": 16 },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "channel": { "type": "string", "enum": ["app", "zalo", "web"] }
        }
      }
    }
  }
}
