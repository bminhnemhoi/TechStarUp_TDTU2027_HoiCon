{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoicon.vn/schemas/drill_offer.v1.json",
  "title": "DrillOffer v1",
  "description": "Thân trả về của `GET /v1/drills/offer` (spec 028, P2-13): bài diễn tập đang trong khung giờ (kịch bản nhúng sẵn để làm được cả khi mất mạng) hoặc `{\"drill\": null}`. `is_drill` luôn là `true`: một lời mời không nói vậy thì máy không phát như diễn tập.",
  "type": "object",
  "additionalProperties": false,
  "required": ["drill"],
  "properties": {
    "drill": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["drill_id", "window_end", "script", "is_drill"],
          "properties": {
            "drill_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
            "window_end": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})$" },
            "is_drill": { "const": true },
            "script": { "$ref": "https://hoicon.vn/schemas/drill_script.v1.json" }
          }
        }
      ]
    }
  }
}
