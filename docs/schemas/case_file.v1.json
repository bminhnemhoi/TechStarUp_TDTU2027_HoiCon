{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoicon.vn/schemas/case_file.v1.json",
  "title": "CaseFile v1",
  "description": "Hồ sơ vụ việc cho người giám hộ (spec 031): GET /v1/guardian/incidents/{id}/case-file. `content` là đúng nội dung cột case_files.content: chỉ dữ kiện máy chủ đã có (dòng thời gian, mức, dấu hiệu, tra cứu, câu trả lời E8, 3 số cuối). Không số điện thoại đầy đủ, h1, HMAC, tên gói, lời kể tự do, tên thật. Diễn tập không bao giờ có hồ sơ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "incident_id", "status", "summary_source", "created_at", "approved_at", "sent_at", "discarded_at", "is_demo", "content"],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "incident_id": { "$ref": "#/$defs/uuid" },
    "status": { "enum": ["draft", "approved", "sent", "discarded"] },
    "summary_source": { "enum": ["template", "llm"] },
    "created_at": { "type": "string", "format": "date-time" },
    "approved_at": { "$ref": "#/$defs/maybe_time" },
    "sent_at": { "$ref": "#/$defs/maybe_time" },
    "discarded_at": { "$ref": "#/$defs/maybe_time" },
    "is_demo": { "type": "boolean" },
    "content": { "$ref": "#/$defs/content" },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "steps", "fallback_vi"],
      "description": "Hướng dẫn trình báo (spec 031 FR-011, FR-015) từ data/case_file/report_guidance.vi.yaml. Chưa duyệt (approved=false) ⇒ steps RỖNG, web chỉ hiện fallback_vi. Không thuộc nội dung hồ sơ (không in như dữ kiện vụ việc). Tùy chọn trong v1; máy chủ gửi luôn từ 031 T019",
      "properties": {
        "approved": { "type": "boolean" },
        "steps": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text_vi"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$" },
              "text_vi": { "type": "string", "minLength": 10, "maxLength": 240 },
              "source_ref": { "type": ["string", "null"], "maxLength": 300, "description": "Nguồn chính thức đã kiểm (Minh duyệt)" }
            }
          }
        },
        "fallback_vi": { "type": "string", "minLength": 10, "maxLength": 240 }
      },
      "if": { "properties": { "approved": { "const": false } } },
      "then": { "properties": { "steps": { "maxItems": 0 } } }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "maybe_time": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "line": { "type": "string", "minLength": 1, "maxLength": 300, "not": { "pattern": "[0-9]{4,}" } },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ai_label", "summary", "elder_alias", "level", "reasons", "rule", "caller_last3", "app_category", "timeline", "elder_answers", "verifications", "guardian_decision", "local_fields"],
      "properties": {
        "schema_version": { "const": 1 },
        "ai_label": { "type": "string", "pattern": "^Đây là trợ lý AI HỏiCon", "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600, "not": { "pattern": "([0-9]{4,}|https?://|www\\.)" } },
        "elder_alias": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Bí danh gia đình đặt (Mẹ, Bố, Bà…), không phải tên thật" },
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "reasons": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/line" } },
        "rule": { "$ref": "#/$defs/line" },
        "caller_last3": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]{3}$" }] },
        "app_category": { "enum": ["bank", "wallet", "securities", "sideloaded", "remote_control", "none"] },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "text"],
            "properties": { "at": { "type": "string", "format": "date-time" }, "text": { "$ref": "#/$defs/line" } }
          }
        },
        "elder_answers": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": { "question": { "$ref": "#/$defs/line" }, "answer": { "$ref": "#/$defs/line" } }
          }
        },
        "verifications": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "verdict", "source", "list_version"],
            "properties": {
              "kind": { "enum": ["phone", "link"] },
              "verdict": { "enum": ["dangerous", "warning", "unknown"] },
              "source": { "type": "string", "maxLength": 80 },
              "list_version": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 40 }] }
            }
          }
        },
        "guardian_decision": { "enum": ["scam", "emergency_pause"] },
        "local_fields": {
          "type": "array",
          "description": "Ô người giám hộ tự điền TRÊN TRÌNH DUYỆT (không gửi máy chủ): chỉ khóa + nhãn, không bao giờ có giá trị",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": { "key": { "type": "string", "pattern": "^[a-z_]{1,32}$" }, "label": { "$ref": "#/$defs/line" } }
          }
        }
      }
    }
  }
}
