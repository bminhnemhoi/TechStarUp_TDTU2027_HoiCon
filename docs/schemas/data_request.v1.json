{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoicon.vn/schemas/data_request.v1.json",
  "title": "DataRequest v1",
  "description": "POST /v1/data-requests (spec 038 FR-004): người được bảo vệ yêu cầu xóa dữ liệu gia đình từ app. `request`: thân gửi lên; `receipt`: thân 202 (mới) hoặc 200 (đã có yêu cầu đang chờ — lũy đẳng). Thi hành bằng job `purge_family` (034), ≤ 72 giờ. Không trường văn bản tự do.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "confirmed"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "confirmed": {
          "const": true,
          "description": "App chỉ gửi sau khi giữ nút 3 giây"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "requested_at",
        "deadline_hours"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "pending",
            "done",
            "failed"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline_hours": {
          "const": 72
        }
      }
    }
  }
}
