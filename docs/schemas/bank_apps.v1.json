{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoicon.vn/schemas/bank_apps.v1.json",
  "title": "BankApps v1",
  "description": "Danh sách app tài chính VN (data/bank_apps.vn.json) cho luật R1 trên máy và khai báo <queries> thay cho QUERY_ALL_PACKAGES. Máy tải bản mới qua GET /v1/config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verified_at", "apps"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(-[a-z0-9]+)?$" },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "verified_at": { "type": "string", "format": "date" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "name", "category"],
        "properties": {
          "package": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$" },
          "name": { "type": "string", "minLength": 1 },
          "org": { "type": "string" },
          "category": { "enum": ["bank", "wallet", "securities"] },
          "play_url": { "type": ["string", "null"], "pattern": "^https://play\\.google\\.com/store/apps/details\\?id=" },
          "demo": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string" },
          "candidate_package": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
