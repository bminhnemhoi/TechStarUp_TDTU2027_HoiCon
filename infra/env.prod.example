# Mẫu biến môi trường PROD (spec 012). Sao chép thành infra/.env.prod, điền, rồi: chmod 600 infra/.env.prod
# infra/.env.prod nằm trong .gitignore — KHÔNG bao giờ commit, KHÔNG dán vào chat/issue. scripts/deploy-vps.sh kiểm định dạng
# từng biến và từ chối chạy nếu thiếu/sai (chỉ in TÊN biến, không in giá trị). Mỗi dòng dạng TÊN=giá_trị, KHÔNG ghi chú cùng dòng.
#
# Sinh khóa ngẫu nhiên (mỗi khóa một lần chạy riêng — không dùng chung giá trị):
#   openssl rand -hex 32    # → pepper, khóa dữ liệu, khóa sao lưu, khóa JWT
#   openssl rand -hex 24    # → mật khẩu Postgres

# --- Mạng ---
# Tên miền đã trỏ A/AAAA về VPS (không kèm https://). Web, API và webhook Zalo dùng chung tên miền này.
HOICON_DOMAIN=
HOICON_ACME_EMAIL=

# --- Postgres (chữ và số, ≥ 24 ký tự: được ghép vào URL kết nối) ---
POSTGRES_PASSWORD=

# --- Khóa bí mật: MẤT LÀ MẤT DỮ LIỆU liên quan. Sao lưu ở nơi KHÁC với bản sao lưu dữ liệu (gồm cả khóa sao lưu). ---
# Pepper băm số điện thoại (ADR-006): mất là không so khớp lại được số đã băm.
HOICON_PHONE_PEPPER_KID=1
HOICON_PHONE_PEPPER_1=
# Chỉ khi xoay pepper (đặt HOICON_PHONE_PEPPER_KID=2): giữ nguyên khóa 1 để vẫn tra được số cũ.
# HOICON_PHONE_PEPPER_2=
# AES-256-GCM mã hóa Zalo chat_id: mất là không gửi được tin cho người giám hộ đã ghép.
HOICON_DATA_KEY_KID=1
HOICON_DATA_KEY_1=
# Khóa ký JWT thiết bị (≥ 32 ký tự): đổi khóa = mọi máy phải ghép đôi lại.
HOICON_DEVICE_JWT_SECRET=
# Khóa sao lưu mã hóa, RIÊNG với khóa dữ liệu: chỉ dùng ở máy chủ (scripts/backup.sh), không đưa vào container ứng dụng.
HOICON_BACKUP_KEY_KID=1
HOICON_BACKUP_KEY_1=

# --- Zalo (docs/setup/ACCOUNTS.md). Chế độ live do compose ép, không đặt ở đây. ---
HOICON_ZALO_BOT_ID=hoicon-dev
HOICON_ZALO_BOT_TOKEN=
# 8–256 ký tự, đúng giá trị đã gửi cho Zalo khi setWebhook (header X-Bot-Api-Secret-Token).
HOICON_ZALO_WEBHOOK_SECRET=

# --- Tùy chọn ---
# Không có khóa Anthropic ⇒ tác tử rơi về mẫu soạn sẵn (an toàn nhưng kém linh hoạt).
# HOICON_ANTHROPIC_API_KEY=
# HOICON_GEMINI_API_KEY=
# MCP `threat` KHÔNG được Caddy phơi ra Internet; biến này chỉ cần khi chạy MCP nội bộ.
# HOICON_MCP_THREAT_CLIENTS=
