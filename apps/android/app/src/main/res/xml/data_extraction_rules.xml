<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: allowBackup="false" không chặn chuyển dữ liệu máy-sang-máy ⇒ loại trừ mọi miền ở cả hai đường.
  Dữ liệu Lính gác (sentinel.db, khóa Tink) không bao giờ rời máy qua sao lưu.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
