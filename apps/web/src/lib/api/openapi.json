 "components": {
  "schemas": {
   "App": {
    "properties": {
     "category": {
      "type": "string",
      "enum": [
       "bank",
       "wallet",
       "securities",
       "sideloaded",
       "other"
      ],
      "title": "Category"
     },
     "package": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Package"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "category"
    ],
    "title": "App"
   },
   "Call": {
    "properties": {
     "direction": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "incoming",
         "outgoing"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Direction"
     },
     "active": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Active"
     },
     "duration_s": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 86400.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Duration S"
     },
     "since_end_s": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 86400.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Since End S"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "Call"
   },
   "Caller": {
    "properties": {
     "h1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "title": "H1"
     },
     "last3": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "title": "Last3"
     },
     "in_contacts": {
      "type": "boolean",
      "title": "In Contacts"
     },
     "trusted": {
      "type": "boolean",
      "title": "Trusted",
      "default": false
     },
     "flagged": {
      "type": "boolean",
      "title": "Flagged",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "h1",
     "last3",
     "in_contacts"
    ],
    "title": "Caller"
   },
   "ConsentBatch": {
    "properties": {
     "items": {
      "items": {
       "$ref": "#/components/schemas/ConsentItem"
      },
      "type": "array",
      "maxItems": 32,
      "minItems": 1,
      "title": "Items"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "items"
    ],
    "title": "ConsentBatch",
